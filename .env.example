# FUSIONARY v1.0 — environment configuration template
# Copy to .env and fill in the values you want to override.

# ── Agent behaviour ────────────────────────────────────────────────────────
FUSIONARY_RESEARCH_DIR=./research
FUSIONARY_MAX_CYCLES=500
FUSIONARY_SAFETY=standard

# ── Web dashboard ──────────────────────────────────────────────────────────
FUSIONARY_PORT=3000
FUSIONARY_HOST=0.0.0.0

# ── LLM API keys (at least one is recommended; the router will fail over) ──
# ZAI (default; uses z-ai-web-dev-sdk — GLM-4.6 etc.)
ZAI_API_KEY=

# Anthropic (Claude Opus / Sonnet — failover)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o etc. — tertiary failover)
OPENAI_API_KEY=

# ── Optional local LLM (Ollama) ────────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
